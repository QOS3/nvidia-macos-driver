+static bool
+nvkmd_nvrm_on_battery(struct nvkmd_nvrm_pdev *pdev, uint64_t now)
+{
+   /* boostAcCached: 0 = uninit (treat as AC), 1 = battery, 2 = AC, 3 = NVRM_610_BOOST_BATT=1 override. */
+   int cached = __atomic_load_n(&pdev->boostAcCached, __ATOMIC_RELAXED);
+   if (cached == 3)
+      return false;
+
+   uint64_t due = __atomic_load_n(&pdev->boostAcCheckNs, __ATOMIC_RELAXED);
+   if (due == 0 || now >= due) {
+      /* Poll power source at most once every 2s across threads; check BOOST_BATT once per pdev. */
+      const uint64_t next = now + 2000000000ull;
+      if (__atomic_compare_exchange_n(&pdev->boostAcCheckNs, &due, next ? next : 1ull, false,
+                                      __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+         if (cached == 0) {
+            const int ov = nvrm610_value("BOOST_BATT");
+            if (ov == '1' || ov == 'y' || ov == 'Y') {
+               __atomic_store_n(&pdev->boostAcCached, 3, __ATOMIC_RELAXED);
+               return false;
+            }
+         }
+         int ac = -1;
+         size_t sz = sizeof ac;
+         if (sysctlbyname("debug.nvrm_tgp_ac", &ac, &sz, NULL, 0) != 0 || (ac != 0 && ac != 1)) {
+            sz = sizeof ac;
+            if (sysctlbyname("debug.hwpfix_ac", &ac, &sz, NULL, 0) != 0 || (ac != 0 && ac != 1))
+               ac = 1;
+         }
+         __atomic_store_n(&pdev->boostAcCached, ac ? 2 : 1, __ATOMIC_RELAXED);
+      }
+      cached = __atomic_load_n(&pdev->boostAcCached, __ATOMIC_RELAXED);
+   }
+   return cached == 1;
+}
